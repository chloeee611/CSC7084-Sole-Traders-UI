<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Register</title>
        <link rel="icon" href="icons/logo.svg" sizes="any" type="image/svg+xml" />
        <link href="/css/styles.css" rel="stylesheet" />
        <link href="/css/pages/login.css" rel="stylesheet" />
    </head>

    <body>
        <a href="/" id="home-button">
            <button class="icon-button">
                <img
                    src="/icons/home.svg"
                    alt="Back to Home"
                    height="50"
                    width="50"
                />
            </button>
        </a>

        <form class="backdrop" action="/trader-register" method="post">
            <a href="/trader-login" class="button">
                <img src="/icons/arrow-left.svg" width=20 height=20/>
                Back to Login
            </a>
            <h3 id="title">Register</h3>
            <div>
                <div class="form-input-group">
                    <label>Name</label>
                    <input type="text" name="name" />
                </div>
                <% if (locals.errorResults && errorResults.name) { %>
                    <p  class="form-error-message"><%= errorResults.name %></p>
                <% } %>
            </div>
            <div>
                <div class="form-input-group">
                    <label>Username</label>
                    <input type="text" name="username" />
                </div>
                <% if (locals.errorResults && errorResults.username) { %>
                    <p  class="form-error-message"><%= errorResults.username %></p>
                <% } %>
            </div>
            <div>
                <div class="form-input-group">
                    <label>Email</label>
                    <input type="email" name="email" />
                </div>
                <% if (locals.errorResults && errorResults.email) { %>
                    <p  class="form-error-message"><%= errorResults.email %></p>
                <% } %>
            </div>
            <div>
                <div class="form-input-group">
                    <label>Password</label>
                    <input type="password" name="password" />
                </div>
                <% if (locals.errorResults && errorResults.password) { %>
                    <p class="form-error-message"><%= errorResults.password %></p>
                <% } %>
            </div>
            <div>
                <div class="form-input-group">
                    <label>Confirm Password</label>
                    <input type="password" name="confirmPassword" />
                </div>
                <% if (locals.errorResults && errorResults.confirmPassword) { %>
                    <p  class="form-error-message"><%= errorResults.confirmPassword %></p>
                <% } %>
            </div>
            <div class="buttons">
                <button class="primary-button" type="submit">Register</button>
            </div>
        
        </form>

    </body>
</html>
