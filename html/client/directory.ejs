<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trader Directory</title>
    <link href="/css/styles.css" rel="stylesheet" />
</head>

<body>
    <div id="container">
        <div id="header">
            <h1 id="text">SOLE TRADERS</h1>
        </div>
        <div id="sidebar">
            <img id="logo" src="/icons/logo.svg" alt="Sole Traders Logo" />
            <ul>
                <li id="present">Trader Directory</li>

                <% if (isloggedin) { %>

                <li><a href="/trader-profile">My Profile</a></li>
                <li><a href="/trader-services">Services</a></li>
                <li><a href="/trader-bookings">Bookings</a></li>
                <li><a href="/trader-login/logout">Logout</a></li>

                <% } else { %>

                <li><a href="/trader-login">Trader Login</a></li>

                <% } %>

                <li><a href="/contact-us">Contact Us</a></li>
            </ul>

            <form class="filters" action="/trader-directory" method="GET">
                <input type="hidden" name="order_by" value="<%= filterParams.order_by %>" />
                <input type="hidden" name="order_direction" value="<%= filterParams.order_direction %>" />
                
                <label>Region</label>
                <div>
                    <input 
                        name="region" 
                        type="text" 
                        value="<%= filterParams.region %>"
                    />
                </div>

                <label>Trade Type</label>
                <div>
                    <select type="text" name="trade_type">
                        <option></option>
                        <% tradeTypes.forEach(({trade_type_id, trade_type_name}) => { %>
                            <option 
                                value="<%= trade_type_id %>" 
                                <% if (trade_type_id == filterParams.trade_type) { %>
                                selected
                                <% } %>
                            >
                                <%=trade_type_name%>
                            </option>
                        <% }) %>
                    </select>
                </div>

                <button type="submit">Filter</button>
            </form>
        </div>
        <div id="main-content">
            <div class="general-content">
                <h1>Trader Directory</h1>
                <p>Click each trader's name to view their profile</p>

                <div class="display-area">
                    

                    <div class="table">
                        <div class="tbl-header">
                            <table>
                                <thead>
                                    <tr>
                                        <% tableHeaders.forEach(({value, label}) => { %>
                                                <th>
                                                    <a href="/trader-directory?region=<%= filterParams.region %>&trade_type=<%= filterParams.trade_type %>&order_by=<%= value %>&order_direction=<%= filterParams.order_by === value && filterParams.order_direction === 'asc' ? 'dsc' : 'asc'  %>"><%= label %></a>
                                                    <% if(filterParams.order_by === value) { %> 
                                                        <%= filterParams.order_direction === 'asc' ? 'Up' : 'Down' %>
                                                    <% } %>
                                                </th>
                                        <% }) %>
                                    </tr>
                                </thead>
                            </table>
                        </div>

                        <div class="tbl-content">
                            <table>
                                <tbody>
                                    <% traders.forEach(trader => { %>
                                        <tr>
                                            <td><a href="/trader-directory/<%= trader.trader_id %>"><%= trader.name %></a></td>
                                            <td><%= trader.trade_type_name %></td>
                                            <td><%= trader.region %></td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
               
            </div>
        </div>
    </div>
</body>

</html>