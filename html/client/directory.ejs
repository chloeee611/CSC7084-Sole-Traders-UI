<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trader Directory</title>
    <link href="/css/styles.css" rel="stylesheet" />
</head>

<body>
    <div id="container">
        <div id="header">
            <h1 id="text">Sole Traders</h1>
        </div>
        <div id="sidebar">
            <ul>
                <li id="present">Trader Directory</li>
                <li><a href="/trader-login">Trader Login</a></li>
                <li><a href="/contact-us">Contact Us</a></li>
            </ul>
        </div>
        <div id="mainContent">
            <% if(locals.bookingMade && bookingMade) { %>
                <p>Thank you for your booking</p>
            <% } %>
            <h1>Welcome to trader directory!</h1>
            <ul>
                <% traders.forEach(trader => { %>
                <li>
                    <a href="/trader-directory/<%= trader.trader_id %>"><%= trader.name %></a> - <%= trader.trade_type_name %> -
                    <%= trader.region %>
                </li>
                <% }) %>
            </ul>
        </div>
    </div>
</body>

</html>