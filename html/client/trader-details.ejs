<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Trader Details</title>
        <link rel="icon" href="icons/logo.svg" sizes="any" type="image/svg+xml" />
        <link href="/css/styles.css" rel="stylesheet" />
        <link href="/css/pages/trader-details.css" rel="stylesheet" />
        <link href="/css/table.css" rel="stylesheet" />
        <link href="/css/form.css" rel="stylesheet" />
        <link href="/css/button.css" rel="stylesheet" />
    </head>

    <body>
        <div id="container">
            <div id="header">
                <h1 class="page-header">SOLE TRADERS</h1>
            </div>

            <%- include('../partials/nav.ejs', {currentPage: 'trader-details'}) %>

            <div id="main-content">
                <div class="general-content">
                    <% if(locals.bookingMade && bookingMade) { %>
                        <p>Thank you for your booking</p>
                    <% } %>

                    <div class="table-filters-header">
                        <div>
                            <h1><%= trader.name %>'s Details</h1>
                            <%= trader.name %> - <%= trader.trade_type_name %> - <%=
                            trader.region %>
                        </div>

                        <form class="rating-star-group" action="/trader-directory/<%= trader.trader_id %>/rate" method="post">
                            <% [1, 2, 3, 4, 5].forEach(rating => { %>
                                <button name="rating" value="<%= rating %>" type="submit" >
                                    <img id="star-icon" 
                                        <% if(locals.currentRating && currentRating >= rating) { %>
                                                src="/icons/star-solid.svg" 
                                        <% } else { %>
                                                src="/icons/star-outline.svg" 
                                        <% } %>
                                    />
                                </button>
                            <% }) %>
                            <% if (trader.average_rating) { %>
                                <div>(<%= Math.round(Number(trader.average_rating) * 10) / 10 %>)</div>
                            <% } %>
                        </form> 
                    </div>

                    <div>
                        <form action="/trader-bookings/bookings/<%= trader.trader_id %>" method="post">
                            <div class="table">
                                <div class="tbl-header services">
                                    <table>
                                        <thead>
                                            <tr>
                                                <th>Title</th>
                                                <th>Description</th>
                                                <th>Pricing Type</th>
                                                <th>Base Price</th>
                                                <th>Select Service</th>
                                            </tr>
                                        </thead>
                                    </table>
                                </div>

                                <div class="tbl-content">
                                    <table>
                                        <tbody>
                                            <% trader.services?.forEach(service => { %>
                                                <tr>
                                                    <td><%= service.title %></td>
                                                    <td><%= service.description %></td>
                                                    <td><%= service.pricing_type %></td>
                                                    <td><%= service.base_price %></td>
                                                    <td><input type="radio" name="serviceId" value="<%= service.service_id %>" /></td>
                                                </tr>
                                            <% }) %>
                                            <!-- TODO: Add service missing error -->
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <div class="form">
                                <div>
                                    <div class="form-input-group">
                                        <label id="fieldLabel">Your Name:</label>
                                        <input name="clientName" type="text" />
                                    </div>
                                    <% if (locals.errorResults && errorResults.clientName) { %>
                                        <p  class="form-error-message"><%= errorResults.clientName %></p>
                                    <% } %>
                                </div>

                                <div>
                                    <div class="form-input-group">
                                        <label>Email Address:</label>
                                        <input name="clientEmailAddress" type="email" />
                                    </div>
                                    <% if (locals.errorResults && errorResults.clientEmailAddress) { %>
                                        <p  class="form-error-message"><%= errorResults.clientEmailAddress %></p>
                                    <% } %>
                                </div>

                                <div>
                                    <div class="form-input-group">
                                        <label>Date and Time:</label>
                                        <input name="requestedDateTime" type="datetime-local" />
                                    </div>
                                    <% if (locals.errorResults && errorResults.requestedDateTime) { %>
                                        <p  class="form-error-message"><%= errorResults.requestedDateTime %></p>
                                    <% } %>
                                </div>

                                <div>
                                    <div class="form-input-group">
                                        <label>Job Description:</label>
                                        <textarea name="jobDescription" type="text"></textarea>
                                    </div>
                                    <% if (locals.errorResults && errorResults.jobDescription) { %>
                                        <p  class="form-error-message"><%= errorResults.jobDescription %></p>
                                    <% } %>
                                </div>
                            </div>

                            <button type="submit" class="primary-button">Request Booking</button>
                        </form>
                    </div>
                </div>

            </div>
        </div>
    </body>
</html>
