<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Trader Details</title>
        <link href="/css/styles.css" rel="stylesheet" />
    </head>

    <body>
        <div id="container">
            <div id="header">
                <h1 id="text">Sole Traders</h1>
            </div>
            <div id="sidebar">
                <ul>
                    <li id="present">Trader Directory</li>
                    <li><a href="/trader-login">Trader Login</a></li>
                    <li><a href="/contact-us">Contact Us</a></li>
                </ul>
            </div>
            <div id="mainContent">
                <h1><%= trader.name %>'s Details</h1>
                <%= trader.name %> - <%= trader.trade_type_name %> - <%=
                trader.region %>

                <form>
                    <div>
                        <label>Your Name:</label>
                        <input type="text" />
                    </div>
                    <div>
                        <label>Email Address:</label>
                        <input type="email" />
                    </div>
                    <div>
                        <label>Required Service:</label>
                        <input type="text" />
                    </div>
                    <div>
                        <label>Date:</label>
                        <input type="date" />
                    </div>
                    <div>
                        <label>Start Time:</label>
                        <input type="time" />
                    </div>
                    <div>
                        <label>Job Description:</label>
                        <textarea name="description" type="text"></textarea>
                    </div>
                    <button type="submit">Request Booking</button>
                </form>
            </div>
        </div>
    </body>
</html>
