<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Home</title>
        <link rel="icon" href="icons/logo.svg" sizes="any" type="image/svg+xml" />
        <link href="/css/styles.css" rel="stylesheet" />
        <link href="/css/pages/home.css" rel="stylesheet" />
    </head>

    <body>
        <div id="container">
            <%- include('../partials/nav.ejs', {currentPage: 'home'}) %>

            <div id="header">
                <h1 class="page-header">SOLE TRADERS</h1>
            </div>

            <div id="main-content">
                <div class="welcome">
                    <h1>Welcome to Sole Traders!</h1>
                    <div class="welcome-buttons">
                        <a href="trader-directory">
                            <button>
                                <img
                                    src="/icons/directory.svg"
                                    alt="Trader Directory"
                                    height="150"
                                    width="150"
                                />
                            </button>
                        </a>
                        <a href="trader-profile">
                            <button>
                                <img
                                    src="/icons/profile.svg"
                                    alt="Trader Profile"
                                    height="150"
                                    width="150"
                                />
                            </button>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </body>
</html>
