<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Home</title>
        <link href="/css/styles.css" rel="stylesheet" />
        <link href="/css/pages/home.css" rel="stylesheet" />
    </head>

    <body>
        <div id="container">
            <div id="sidebar">
                <img id="logo" src="/icons/logo.svg" alt="Sole Traders Logo" />
                <ul>
                    <li><a href="trader-directory">Trader Directory</a></li>

                    <% if (isloggedin) { %>

                    <li><a href="/trader-profile">My Profile</a></li>
                    <li><a href="/trader-services">Services</a></li>
                    <li><a href="/trader-bookings">Bookings</a></li>
                    <li><a href="/trader-login/logout">Logout</a></li>

                    <% } else { %>

                    <li><a href="/trader-login">Trader Login</a></li>

                    <% } %>

                    <li><a href="contact-us">Contact Us</a></li>
                </ul>
            </div>

            <div id="header">
                <h1 id="text">SOLE TRADERS</h1>
            </div>

            <div id="main-content">
                <div class="welcome">
                    <h1>Welcome to Sole Traders!</h1>
                    <div class="welcome-buttons">
                        <a href="trader-directory">
                            <button>
                                <img
                                    src="/icons/directory.svg"
                                    alt="Trader Directory"
                                    height="150"
                                    width="150"
                                />
                            </button>
                        </a>
                        <a href="trader-profile">
                            <button>
                                <img
                                    src="/icons/profile.svg"
                                    alt="Trader Profile"
                                    height="150"
                                    width="150"
                                />
                            </button>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </body>
</html>
