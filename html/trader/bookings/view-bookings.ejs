<!DOCTYPE html>
<html lang="en">
    
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Services</title>
    <link href="/css/styles.css" rel="stylesheet" />
    <link href="/css/login.css" rel="stylesheet" />
</head>

<body>
    <div id="container">
        <div id="header">
            <h1 id="text">Sole Traders</h1>
        </div>

        <div id="sidebar">
            <img id="logo" src="/icons/logo.svg" alt="Sole Traders Logo" />
            <ul>
                <li><a href="/trader-directory">Trader Directory</a></li>
                <li><a href="/trader-profile">My Profile</a></li>
                <li><a href="/trader-profile/edit/<%= trader.trader_id %>">Edit Profile</a></li>
                <li><a href="/trader-services">Manage Services</a></li>
                <li id="present">Manage Bookings</a></li>
                <li><a href="/trader-login/logout">Logout</a></li>
                <li><a href="/contact-us">Contact Us</a></li>
            </ul>
        </div>

        <div id="main-content">
            <div class="general-content">
            <h1>My Bookings</h1>

                <table>
                    <thead>
                        <tr>
                            <th>Client Name</th>
                            <th>Client Email Address</th>
                            <th>Date and Time</th>
                            <th>Job Description</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% bookings.forEach(booking => { %>
                            <tr>
                                <td><%= booking.client_name %></td>
                                <td><%= booking.client_email_address %></td>
                                <td><%= booking.requested_date_time %></td>
                                <td><%= booking.job_description %></td>
                                <td><%= booking.status %></td>
                                <td><% if (booking.status === "pending") { %>
                                    <form method="post" action="/trader-bookings/<%= booking.booking_id %>/status" style="display:inline;">
                                        <input type="hidden" name="status" value="confirmed">
                                        <button type="submit" id="accept-button">Accept</button>
                                    </form>

                                    <form method="post" action="/trader-bookings/<%= booking.booking_id %>/status" style="display:inline;">
                                        <input type="hidden" name="status" value="rejected">
                                        <button type="submit" id="reject-button">Reject</button>
                                    </form>
                                <% } %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</body>

</html>