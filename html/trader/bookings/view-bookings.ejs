<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>My Services</title>
        <link rel="icon" href="icons/logo.svg" sizes="any" type="image/svg+xml" />
        <link href="/css/styles.css" rel="stylesheet" />
        <link href="/css/pages/view-bookings.css" rel="stylesheet" />
        <link href="/css/table.css" rel="stylesheet" />
        <link href="/css/button.css" rel="stylesheet" />
        <link href="/css/form.css" rel="stylesheet" />
    </head>

    <body>
        <div id="container">
            <div id="header">
                <h1 class="page-header">SOLE TRADERS</h1>
            </div>

            <%- include('../../partials/nav.ejs', {currentPage: 'view-bookings'}) %>

            <div id="main-content">
                <div class="general-content">
                    <div class="table-filters-header">

                        <div class="bookings-header">
                            <h1>My Bookings</h1>
                        </div>

                        <form class="filters" action="/trader-bookings" method="GET">
                            <input type="hidden" name="order_by" value="<%= filterParams.order_by %>" />
                            <input type="hidden" name="order_direction" value="<%= filterParams.order_direction %>" />

                            <div>
                                <label>Status</label>
                                <div>
                                    <select type="text" name="status">
                                        <option></option>
                                        <% bookingStatuses.forEach(({value, label}) => { %>
                                            <option 
                                                value="<%= value %>" 
                                                <% if (value == filterParams.status) { %>
                                                selected
                                                <% } %>
                                            >
                                                <%=label%>
                                            </option>
                                        <% }) %>
                                    </select>
                                </div>
                            </div>

                            <button type="submit">Filter</button>
                        </form>
                    </div>

                    <div class="display-area">
                        <div class="table">
                            <div class="tbl-header">
                                <table>
                                    <thead>
                                        <tr>
                                            <% tableHeaders.forEach(({value, label}) => { %>
                                                <th>
                                                    <a class="sort-header" href="/trader-bookings?status=<%= filterParams.status %>&order_by=<%= value %>&order_direction=<%= filterParams.order_by === value && filterParams.order_direction === 'asc' ? 'dsc' : 'asc'  %>">
                                                        <%= label %>
                                                        <% if(filterParams.order_by === value) { %> 
                                                            <% if (filterParams.order_direction === 'asc') { %>
                                                                <img class="sort-icon" src="/icons/arrow-down-a-z.svg" alt="A to Z sort" />
                                                            <% } else { %>
                                                                <img class="sort-icon" src="/icons/arrow-down-z-a.svg" alt="Z to A sort" />
                                                            <% } %>
                                                        <% } %>
                                                    </a>
                                                </th>
                                            <% }) %>
                                            <th class="action-header">Action</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                        
                            <div class="tbl-content">
                                <table>
                                    <tbody>
                                        <% bookings.forEach(booking => { %>
                                            <tr>
                                                <td><%= booking.client_name %></td>
                                                <td><%= booking.client_email_address %></td>
                                                <td><%= new Date(booking.requested_date_time).toLocaleString() %></td>
                                                <td><%= booking.job_description %></td>
                                                <td><%= booking.status %></td>
                                                <td><% if (booking.status === "pending") { %>
                                                    <div class="bookings-action-buttons">
                                                        <form method="post" action="/trader-bookings/<%= booking.booking_id %>/status">
                                                            <button class="success-button" type="submit" name="status" value="confirmed">Accept</button>
                                                        </form>

                                                        <form method="post" action="/trader-bookings/<%= booking.booking_id %>/status">
                                                            <button class="danger-button" type="submit" name="status" value="rejected">Reject</button>
                                                        </form>
                                                    </div>
                                                <% } %></td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </body>
</html>