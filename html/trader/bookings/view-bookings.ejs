<!DOCTYPE html>
<html lang="en">
    
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Services</title>
    <link href="/css/styles.css" rel="stylesheet" />
    <link href="/css/pages/view-bookings.css" rel="stylesheet" />
    <link href="/css/table.css" rel="stylesheet" />
</head>

<body>
    <div id="container">
        <div id="header">
            <h1 id="text">SOLE TRADERS</h1>
        </div>

        <div id="sidebar">
            <img id="logo" src="/icons/logo.svg" alt="Sole Traders Logo" />
            <ul>
                <li><a href="/trader-directory">Trader Directory</a></li>
                <li><a href="/trader-profile">My Profile</a></li>
                <li><a href="/trader-services">Services</a></li>
                <li id="present">Bookings</li>
                <li><a href="/trader-login/logout">Logout</a></li>
                <li><a href="/contact-us">Contact Us</a></li>
            </ul>

            <form class="filters" action="/trader-bookings" method="GET">
                <input type="hidden" name="order_by" value="<%= filterParams.order_by %>" />
                <input type="hidden" name="order_direction" value="<%= filterParams.order_direction %>" />

                <label>Status</label>
                <select type="text" name="status">
                    <option></option>
                    <% bookingStatuses.forEach(({value, label}) => { %>
                        <option 
                            value="<%= value %>" 
                            <% if (value == filterParams.status) { %>
                            selected
                            <% } %>
                        >
                            <%=label%>
                        </option>
                    <% }) %>
                </select>

                <button type="submit">Filter</button>
            </form>
        </div>

        <div id="main-content">
            <div class="general-content">
                <h1>My Bookings</h1>

                  <div class="display-area">
                    

                    <div class="table">
                        <div class="tbl-header">
                            <table>
                                <thead>
                                    <tr>
                                        <% tableHeaders.forEach(({value, label}) => { %>
                                            <th>
                                                <a href="/trader-bookings?status=<%= filterParams.status %>&order_by=<%= value %>&order_direction=<%= filterParams.order_by === value && filterParams.order_direction === 'asc' ? 'dsc' : 'asc'  %>"><%= label %></a>
                                                <% if(filterParams.order_by === value) { %> 
                                                    <p><%= filterParams.order_direction === 'asc' ? 'Up' : 'Down' %></p>
                                                <% } %>
                                            </th>
                                        <% }) %>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                            </table>
                        </div>

                        <div class="tbl-content">
                            <table>
                                <tbody>
                                    <% bookings.forEach(booking => { %>
                                        <tr>
                                            <td><%= booking.client_name %></td>
                                            <td><%= booking.client_email_address %></td>
                                            <td><%= new Date(booking.requested_date_time).toLocaleString() %></td>
                                            <td><%= booking.job_description %></td>
                                            <td><%= booking.status %></td>
                                            <td><% if (booking.status === "pending") { %>
                                                <form method="post" action="/trader-bookings/<%= booking.booking_id %>/status">
                                                    <button id="accept-button" type="submit" name="status" value="confirmed">Accept</button>
                                                </form>

                                                <form method="post" action="/trader-bookings/<%= booking.booking_id %>/status">
                                                    <button id="reject-button" type="submit" name="status" value="rejected">Reject</button>
                                                </form>
                                            <% } %></td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</body>

</html>