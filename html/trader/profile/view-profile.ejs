<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trader Profile</title>
    <link href="/css/styles.css" rel="stylesheet" />
</head>

<body>
    <div id="container">
        <div id="header">
            <h1 id="text">Sole Traders</h1>
        </div>
        <div id="sidebar">
            <img id="logo" src="/icons/logo.svg" alt="Sole Traders Logo" />
            <ul>
                <li><a href="/trader-directory">Trader Directory</a></li>
                <% if (isloggedin) { %>
                    <li id="present">My Profile</a></li>
                    <li><a href="/trader-profile/edit/<%= trader.trader_id %>">Edit Profile</a></li>
                    <li><a href="/trader-services">Manage Services</a></li>
                    <li><a href="/trader-bookings">Manage Bookings</a></li>
                    <li><a href="/trader-login/logout">Logout</a></li>
                <% } else { %>
                    <li><a href="/trader-login">Trader Login</a></li>
                <% } %>
                <li><a href="/contact-us">Contact Us</a></li>
            </ul>
        </div>
        <% if (isloggedin) { %>
            <div id="main-content">
                <div class="general-content">
                    <h1>Welcome to your profile!</h1>

                    <h2>Your Details</h2>
                    <p><strong>Name:</strong> <%= trader.name %></p>
                    <p><strong>Username:</strong> <%= trader.username %></p>
                    <p><strong>Email:</strong> <%= trader.email %></p>

                    <h2>Your Profile</h2>
                    <p><strong>Trade type:</strong> <%= trader.trade_type_name || "Not set" %></p>
                    <p><strong>Region/Town:</strong> <%= trader.region || "Not set" %></p>
                    <p><strong>Availability:</strong> <%= trader.availability || "Not set" %></p>
                    <p><strong>Bio:</strong> <%= trader.bio || "Not set" %></p>
                </div>
            </div>
        <% } else { %>
            Please login first
        <% } %>
    </div>
</body>

</html>