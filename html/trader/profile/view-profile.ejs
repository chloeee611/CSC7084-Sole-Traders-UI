<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Trader Profile</title>
        <link rel="icon" href="icons/logo.svg" sizes="any" type="image/svg+xml" />
        <link href="/css/styles.css" rel="stylesheet" />
        <link href="/css/pages/view-profile.css" rel="stylesheet" />
    </head>

    <body>
        <div id="container">
            <div id="header">
                <h1 id="text">SOLE TRADERS</h1>
            </div>
            
            <%- include('../../partials/nav.ejs', {currentPage: 'view-profile'}) %>

            <% if (isloggedin) { %>
                <div id="main-content">
                    <div class="general-content">
                        <div class="profile-content">
                            <div class="profile-header">
                                <h1>Personal Info</h1>
                                <a class="edit-profile-container" href="/trader-profile/edit/<%= trader.trader_id %>">
                                    <img src="/icons/pencil.svg" />
                                    <p>Edit Profile</p>
                                </a>
                            </div>
                            <div class="profile-item top-item">
                                <img src="/icons/id-badge.svg" class="profile-icon" />
                                <div class="profile-text">
                                    <p><strong>Name</strong></p> 
                                    <p><%= trader.name %></p>
                                </div>
                            </div>

                            <div class="profile-item">
                                <img src="/icons/username.svg" class="profile-icon" />
                                <div class="profile-text">
                                    <p><strong>Username</strong></p> 
                                    <p><%= trader.username %></p>
                                </div>
                            </div>

                            <div class="profile-item">
                                <img src="/icons/envelope.svg" class="profile-icon" />
                                <div class="profile-text">
                                    <p><strong>Email</strong></p> 
                                    <p><%= trader.email %></p>
                                </div>
                            </div>

                            <div class="profile-item">
                                <img src="/icons/hammer.svg" class="profile-icon" />
                                <div class="profile-text">
                                    <p><strong>Trade type</strong></p> 
                                    <p><%= trader.trade_type_name || "Not set" %></p>
                                </div>
                            </div>

                            <div class="profile-item">
                                <img src="/icons/house.svg" class="profile-icon" />
                                <div class="profile-text">
                                    <p><strong>Region</strong></p> 
                                    <p><%= trader.region || "Not set" %></p>
                                </div>
                            </div>

                            <div class="profile-item">
                                <img src="/icons/calendar.svg" class="profile-icon" />
                                <div class="profile-text">
                                    <p><strong>Availability</strong></p> 
                                    <p><%= trader.availability || "Not set" %></p>
                                </div>
                            </div>

                            <div class="profile-item bottom-item">
                                <img src="/icons/document.svg" class="profile-icon" />
                                <div class="profile-text">
                                    <p><strong>Bio</strong></p> 
                                    <p><%= trader.bio || "Not set" %></p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            <% } else { %>
                Please login first
            <% } %>
        </div>
    </body>
</html>