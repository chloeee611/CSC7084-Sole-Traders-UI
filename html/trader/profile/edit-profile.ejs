<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Trader Details</title>
        <link rel="icon" href="icons/logo.svg" sizes="any" type="image/svg+xml" />
        <link href="/css/styles.css" rel="stylesheet" />
        <link href="/css/form.css" rel="stylesheet" />
        <link href="/css/button.css" rel="stylesheet" />
    </head>

    <body>
        <div id="container">
            <div id="header">
                <h1 class="page-header">SOLE TRADERS</h1>
            </div>
            
            <%- include('../../partials/nav.ejs', {currentPage: 'edit-profile'}) %>

            <div id="main-content">
                <div class="general-content">
                    <h1>Edit your profile</h1>

                    <form action="/trader-profile/edit/<%= trader.trader_id %>" method="post">
                        
                        <div class="form">
                            <div>
                                <div class="form-input-group">
                                    <label>Trade Type</label>
                                    <select type="text" name="tradeType">
                                        <option></option>
                                        <% tradeTypes.forEach(({trade_type_id, trade_type_name}) => { %>
                                            <option 
                                                value="<%= trade_type_id %>" 
                                                <% if (trader.trade_type_id === trade_type_id) { %>
                                                selected
                                                <% } %>
                                            >
                                                <%=trade_type_name%>
                                            </option>
                                        <% }) %>
                                    </select>
                                </div>
                                <% if (locals.errorResults && errorResults.tradeType) { %>
                                    <p  class="form-error-message"><%= errorResults.tradeType %></p>
                                <% } %>
                            </div>

                            <div>
                                <div class="form-input-group">
                                    <label>Region</label>
                                    <input
                                        type="text"
                                        name="region"
                                        value="<%= trader.region %>"
                                    />
                                </div>
                                <% if (locals.errorResults && errorResults.region) { %>
                                    <p  class="form-error-message"><%= errorResults.region %></p>
                                <% } %>
                            </div>

                            <div>
                                <div class="form-input-group">
                                    <label>Availability</label>
                                    <input
                                        type="text"
                                        name="availability"
                                        value="<%= trader.availability %>"
                                    />
                                </div>
                                <% if (locals.errorResults && errorResults.availability) { %>
                                    <p  class="form-error-message"><%= errorResults.availability %></p>
                                <% } %>
                            </div>

                            <div>
                                <div class="form-input-group">
                                    <label>Bio</label>
                                    <textarea name="bio"><%= trader.bio %></textarea>
                                </div>
                                <% if (locals.errorResults && errorResults.bio) { %>
                                    <p  class="form-error-message"><%= errorResults.bio %></p>
                                <% } %>
                            </div>
                        </div>

                        <div class="buttons">
                            <button class="primary-button" type="submit">Update</button>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </body>
</html>
