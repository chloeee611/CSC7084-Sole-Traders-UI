<!DOCTYPE html>
<html lang="en">
    
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Services</title>
    <link href="/css/styles.css" rel="stylesheet" />
    <link href="/css/login.css" rel="stylesheet" />
</head>

<body>
    <div id="container">
        <div id="header">
            <h1 id="text">Sole Traders</h1>
        </div>

        <div id="sidebar">
            <img id="logo" src="/icons/logo.svg" alt="Sole Traders Logo" />
            <ul>
                <li><a href="/trader-directory">Trader Directory</a></li>
                <li><a href="/trader-profile">My Profile</a></li>
                <li id="present">Services</a></li>
                <li><a href="/trader-bookings">Bookings</a></li>
                <li><a href="/trader-login/logout">Logout</a></li>
                <li><a href="/contact-us">Contact Us</a></li>
            </ul>
        </div>

        <div id="main-content">
            <div class="general-content">
                <div class="profile-header">
                    <h1>My Services</h1>
                    <a href="/trader-services/new-service">
                        <img src="/icons/square-plus.svg" class="profile-icon" />
                        New Service
                    </a>
                </div>

                <div class="tbl-header">
                    <table>
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Description</th>
                                <th>Pricing Type</th>
                                <th>Base Price</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                    </table>
                </div>

                <div class="tbl-content">
                    <table>
                        <tbody>
                            <% services.forEach(service => { %>
                                <tr>
                                    <td><%= service.title %></td>
                                    <td><%= service.description %></td>
                                    <td><%= service.pricing_type %></td>
                                    <td>£<%= service.base_price.toFixed(2) %></td>
                                    <td>
                                        <a href="/trader-services/edit/<%= service.service_id %>">Edit</a>

                                        <form method="post" action="/trader-services/delete/<%= service.service_id %>" style="display:inline;">
                                            <button type="submit" onclick="return confirm('Delete this service?')">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    </div>
</body>

</html>