<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>My Services</title>
        <link rel="icon" href="icons/logo.svg" sizes="any" type="image/svg+xml" />
        <link href="/css/styles.css" rel="stylesheet" />
        <link href="/css/login.css" rel="stylesheet" />
        <link href="/css/form.css" rel="stylesheet" />
        <link href="/css/button.css" rel="stylesheet" />
    </head>

    <body>
        <div id="container">
            <div id="header">
                <h1 class="page-header">SOLE TRADERS</h1>
            </div>

            <%- include('../../partials/nav.ejs', {currentPage: 'edit-service'}) %>

            <div id="main-content">
                <div class="general-content">
                    <h1>Edit Service</h1>

                    <form action="/trader-services/edit/<%= service.service_id %>" method="post">
                        <div class="form">
                            <div>
                                <div class="form-input-group">
                                    <label>Title</label>
                                    <input 
                                        name="title" 
                                        type="text"
                                        value="<%= service.title %>"
                                    />
                                </div>
                                <% if (locals.errorResults && errorResults.title) { %>
                                    <p  class="form-error-message"><%= errorResults.title %></p>
                                <% } %>
                            </div>
                            
                            <div>
                                <div class="form-input-group">
                                    <label>Description</label>
                                    <input 
                                        name="description" 
                                        type="text" 
                                        value="<%= service.description %>"
                                    />
                                </div>
                                <% if (locals.errorResults && errorResults.description) { %>
                                    <p  class="form-error-message"><%= errorResults.description %></p>
                                <% } %>
                            </div>

                            <div>
                                <div class="form-input-group">
                                    <label>Pricing Type</label>
                                    <select 
                                        name="pricingType"
                                        value="<%= service.pricing_type %>"
                                    >
                                        <option 
                                            value="Hourly"
                                            <% if (service.pricing_type === 'Hourly') { %>
                                                    selected
                                            <% } %>
                                        >
                                            Hourly
                                        </option>
                                        <option 
                                            value="Fixed"
                                            <% if (service.pricing_type === 'Fixed') { %>
                                                    selected
                                            <% } %>
                                        >
                                            Fixed
                                        </option>
                                    </select>
                                </div>
                                <% if (locals.errorResults && errorResults.pricingType) { %>
                                    <p  class="form-error-message"><%= errorResults.pricingType %></p>
                                <% } %>
                            </div>

                            <div>
                                <div class="form-input-group">
                                    <label>Base Price</label>
                                    <input 
                                        name="basePrice" 
                                        type="number" 
                                        step=".01"
                                        value="<%= service.base_price %>"
                                    />
                                </div>
                                <% if (locals.errorResults && errorResults.basePrice) { %>
                                    <p  class="form-error-message"><%= errorResults.basePrice %></p>
                                <% } %>
                            </div>
                        </div>

                        <button class="primary-button" type="submit">Edit</button>
                    </form>
                </div>
            </div>
        </div>
    </body>
</html>